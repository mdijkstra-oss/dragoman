# Copy to .env.local, which make run and make serve read. Provider keys are the
# only credentials dragoman reads; each service in the table names the variable
# holding its key, and a service whose variable is unset is served, reports
# itself unavailable on GET /services, and fails when it is called.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Caller headers to put on every log line for the request. Only X- headers are
# allowed, at most 16, and a name reading as a credential is refused.
# LOG_REQUEST_HEADERS=X-Session-ID,X-Project-ID

# The listen address is a flag, not a variable: dragoman serve --addr.
